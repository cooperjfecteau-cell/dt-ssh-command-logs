{
  "enabled": true,
  "description": "Local development activation. Point it at tools/local_ssh_server.py, not a real host.",
  "version": "0.2.0",
  "activationContext": "REMOTE",
  "pythonRemote": {
    "endpoints": [
      {
        "name": "local-test-server",
        "host": "127.0.0.1",
        "port": 2222,
        "username": "demo",
        "authType": "password",
        "password": "{{sshPassword}}",
        "hostKeyVerification": "acceptAny",
        "commands": [
          {
            "name": "uptime-and-disk",
            "command": "uptime && df -h /",
            "timeoutSeconds": 0,
            "logSource": ""
          },
          {
            "name": "failed-units",
            "command": "systemctl is-failed nginx",
            "timeoutSeconds": 0,
            "logSource": ""
          }
        ],
        "usePty": false,
        "intervalMinutes": 1,
        "connectTimeoutSeconds": 10,
        "commandTimeoutSeconds": 30,
        "logSource": "ssh.command",
        "splitLines": true,
        "maxLines": 1000,
        "maxOutputBytes": 1048576,
        "additionalAttributes": [
          {
            "key": "environment",
            "value": "local-dev"
          }
        ]
      }
    ]
  }
}
